{
  "name": "papeliz",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "site:dev": "pnpm --filter @papeliz/site dev",
    "site:build": "pnpm --filter @papeliz/site build && node build_tools/site/papeliz-site-repair-windows-segment-files.mjs && node build_tools/site/papeliz-site-account-csp-hashes.mjs",
    "site:typecheck": "pnpm --filter @papeliz/site typecheck",
    "site:lint": "pnpm --filter @papeliz/site lint",
    "site:verify": "pnpm --filter @papeliz/site verify",
    "site:test": "pnpm --filter @papeliz/site test",
    "help:dev": "pnpm --filter @papeliz/help-site dev",
    "help:build": "pnpm --filter @papeliz/help-site build && node build_tools/site/papeliz-site-repair-windows-segment-files.mjs site/help/out",
    "help:typecheck": "pnpm --filter @papeliz/help-site typecheck",
    "help:lint": "pnpm --filter @papeliz/help-site lint",
    "help:verify": "pnpm --filter @papeliz/help-site verify",
    "webapp:dev": "pnpm --filter @papeliz/webapp dev",
    "webapp:build": "pnpm --filter @papeliz/webapp build && node build_tools/webapp/papeliz-webapp-worker-headers.mjs",
    "webapp:typecheck": "pnpm --filter @papeliz/webapp typecheck",
    "webapp:test": "pnpm --filter @papeliz/webapp test",
    "webapp:lint": "pnpm --filter @papeliz/webapp lint",
    "webapp:browser-test": "pnpm --filter @papeliz/webapp browser-test",
    "desktop:dev": "node build_tools/desktop/papeliz-desktop-tauri-command.mjs dev",
    "desktop:build": "node build_tools/desktop/papeliz-desktop-tauri-command.mjs build",
    "desktop:build:recording-devtools": "node build_tools/desktop/papeliz-desktop-tauri-command.mjs build-recording-devtools",
    "desktop:typecheck": "pnpm --filter @papeliz/desktop typecheck",
    "desktop:msix": "node build_tools/desktop/papeliz-desktop-msix-pack.mjs",
    "mobile:android:dev": "node build_tools/mobile/papeliz-mobile-tauri-command.mjs android dev",
    "mobile:android:build": "node build_tools/mobile/papeliz-mobile-tauri-command.mjs android build --apk",
    "mobile:typecheck": "pnpm --filter @papeliz/mobile typecheck",
    "mobile:check-web-dist": "node build_tools/mobile/papeliz-mobile-check-web-dist.mjs",
    "deploy:assemble": "pnpm run site:build && pnpm run webapp:build && pnpm run help:build && node build_tools/shared/deploy-folder/papeliz-deploy-folder-assemble.mjs"
  }
}
