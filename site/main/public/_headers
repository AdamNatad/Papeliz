# Response headers for the static host (Cloudflare Workers static assets reads this file).
# The webapp at /app/ is served by its own Worker, with its own _headers and strict policy.
#
# Every website page also carries a script policy of its own in a <meta> tag, which the site build
# writes (site/main/scripts/papeliz-site-page-script-policy.mjs): its script-src allows only this
# site's script files and the SHA-256 hash of each inline script on that page. A <meta> policy can't
# set frame-ancestors, so that stays here, with object-src and base-uri for every page on the domain.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'; base-uri 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The account page signs people in, and shares this origin with the app's AI keys, so it gets the
# strictest policy the site's static pages allow. Scripts come only from this site (Clerk's code is
# bundled into it) and from Cloudflare's bot check, which Clerk shows when it asks for one. The page
# talks only to this site and to Clerk's Frontend API. Google and Apple sign-in are full-page
# redirects, which need no connection rule. 'unsafe-inline' here only stands in for the inline
# scripts Next writes into the page: the site build swaps it, in the exported _headers, for the
# SHA-256 hash of each one (build_tools/site/papeliz-site-account-csp-hashes.mjs).
/account/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://clerk.papeliz.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'
  Cache-Control: no-store
