// Cloudflare Workers static assets for the website's export. Nothing is deployed until Adam says
// so. No route yet: the domain is still open. The site, the help site and the webapp are
// assembled into one folder (`pnpm deploy:assemble`, `deploy/`); point assets.directory at that
// folder before the first deploy.
{
  "name": "papeliz-site",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
