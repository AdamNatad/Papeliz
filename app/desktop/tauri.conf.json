{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Papeliz",
  "version": "1.0.0-preview.1",
  "identifier": "com.papeliz.desktop",
  "build": {
    "frontendDist": "papeliz-desktop-webapp-build",
    "devUrl": "http://127.0.0.1:14207/",
    "beforeDevCommand": "pnpm --filter @papeliz/webapp exec vite --host 127.0.0.1 --port 14207 --strictPort"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": ["style-src"],
      "headers": {
        "Permissions-Policy": "camera=(), microphone=(self), geolocation=()"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Natad Corporation",
    "copyright": "Copyright (c) 2026 Natad Corporation",
    "homepage": "https://papeliz.com",
    "license": "MIT",
    "licenseFile": "installer/papeliz-end-user-license-agreement.txt",
    "category": "Productivity",
    "shortDescription": "Papeliz is a Free, Open-Source Markdown Editor for your Personal Knowledge Base, with a built-in AI Assistant and Workflow Templates for Coding and AI Agents.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installer/papeliz-installer-sidebar-blue.bmp",
        "headerImage": "installer/papeliz-installer-header-blue.bmp",
        "uninstallerHeaderImage": "installer/papeliz-installer-header-blue.bmp",
        "template": "installer/papeliz-installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxMEZGQjgwNDhBMjhDNTYKUldSV2pLSklnUHNQMFRJa2Z6VktDQm1uTzI3WGR0UTB3SExKN0dxcmVSNHZRcXRReHVrcU8wRkIK",
      "endpoints": ["https://github.com/AdamNatad/Papeliz/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
