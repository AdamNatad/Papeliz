# The local Account Worker's billing for `webapp start sync-local`, in the payment provider's test mode
# only. To test billing, copy this file to papeliz-sync-local-payment-settings.env beside it (Git-ignored)
# and type the two secrets in yourself. The launcher refuses a live key or the live API, prints no value,
# and leaves billing off while a value is empty: a checkout needs the first three settings, and a webhook
# needs all four.

# The payment provider's test API.
PAPELIZ_SYNC_PAYMENT_PROVIDER_API_URL=https://test-api.creem.io

# Papeliz Sync's test-mode products, one per paid plan and billing period. Live mode has its own.
PAPELIZ_SYNC_PLAN_PRODUCT_IDS={"standard":{"monthly":"prod_6TV5nviU6p78kdQzArZMnu","yearly":"prod_K6SdHAdP32lFfp4MOpmgt"},"plus":{"monthly":"prod_677ekcNtZeoNKwuUloAWdi","yearly":"prod_271jiUJMSgeXPew16TZV25"},"pro":{"monthly":"prod_7Hz7SpmnObNkwA2FtfZm3Q","yearly":"prod_1mqILtBX3glllDy4x2yez6"}}

# Secret: the payment provider's test-mode API key, which starts with creem_test_.
PAPELIZ_SYNC_PAYMENT_PROVIDER_API_KEY=

# Secret: the signing secret of the test store's webhook endpoint that forwards to this computer
# (`creem listen`).
PAPELIZ_SYNC_PAYMENT_PROVIDER_WEBHOOK_SECRET=
